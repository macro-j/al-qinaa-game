# Supabase — frontend (Vite exposes only VITE_* to the browser bundle)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase — api-server (Node; not bundled into the client)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# api-server
PORT=8080
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Comma-separated allowed origins in production (e.g. https://your-app.example)
# CORS_ORIGIN=https://your-app.example

# qinaa frontend (optional — Vite dev proxy uses http://localhost:3000 when unset)
# VITE_API_URL=http://localhost:3000
