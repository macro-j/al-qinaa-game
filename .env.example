# Supabase — frontend (Vite exposes only VITE_* to the browser bundle)
# IMPORTANT: put these in the MONOREPO ROOT .env (al-qinaa-game/.env), NOT artifacts/qinaa/.env
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase — api-server (Node; not bundled into the client)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# api-server
PORT=8080
# Tap Payments (test key — override in production)
TAP_SECRET_KEY=sk_test_your_tap_key_here
# Public URLs used for Tap redirect + webhook callbacks
# PUBLIC_APP_URL=http://localhost:5173
# PUBLIC_SERVER_URL=http://localhost:3000
# Comma-separated allowed origins in production (e.g. https://your-app.example)
# CORS_ORIGIN=https://your-app.example

# qinaa frontend (optional — Vite dev proxy uses http://localhost:3000 when unset)
# VITE_API_URL=http://localhost:3000
