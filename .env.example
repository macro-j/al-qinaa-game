# Supabase — frontend (Vite exposes only VITE_* to the browser bundle)
# IMPORTANT: put these in the MONOREPO ROOT .env (al-qinaa-game/.env), NOT artifacts/qinaa/.env
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase — api-server (Node; not bundled into the client)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# api-server
PORT=8080
# Paylink Payments — server-side only (never prefix these with VITE_)
PAYLINK_ENV=pilot
PAYLINK_API_ID=APP_ID_your_paylink_id
PAYLINK_SECRET_KEY=your_paylink_secret
PAYLINK_WEBHOOK_TOKEN=generate_a_long_random_secret
# Public URL used for Paylink callback/cancel redirects
# PUBLIC_APP_URL=http://localhost:5173
# Comma-separated allowed origins in production (e.g. https://your-app.example)
# CORS_ORIGIN=https://your-app.example

# qinaa frontend — production API origin (required when frontend and api-server are on different hosts)
# VITE_PUBLIC_SERVER_URL=https://api.your-app.example
# VITE_API_URL=http://localhost:3000
